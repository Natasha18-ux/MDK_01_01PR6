<Window x:Class="TV_Patrusheva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TV_Patrusheva"
        mc:Ignorable="d"
        Title="Телевизор" Height="475" Width="800" MinHeight="475" MinWidth="800" FontFamily="Arial Narrow">
    <Grid Background="#FF383838">
        <Label 
            x:Name="NameChannel"
            Content="Название программы"
            HorizontalAlignment="Left"
            Margin="20,10,0,0"
            VerticalAlignment="Top"
            Foreground="White">
        </Label>
        <MediaElement
            x:Name="VideoPlayer"
            LoadedBehavior="Manual"
            Volume="1"
            Stretch="UniformToFill"
            Margin="20,41,20,68">
        </MediaElement>
        <Grid Margin="0,374,0,0" Height="60" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="29*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36*"/>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="129*"/>
            </Grid.ColumnDefinitions>
            <Button
                Click="BackChannel"
                Content="Назад"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="128"
                Height="21"
                Background="White" Grid.Row="1"/>
            <Button
                Click="NextChannel"
                Content="Вперёд"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="122"
                Height="21"
                Background="White" Grid.Column="1" Grid.Row="1"/>
            <Button
                Content="Тише"
                HorizontalAlignment="Right"
                Margin="0,0,115,10"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Background="White"
                Click="GetLouder" Grid.Column="2" Grid.RowSpan="2">
            </Button>
            <Button
                Content="Громче"
                HorizontalAlignment="Right"
                Margin="0,0,10,10"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Background="White"
                Click="GetQuieter" Grid.Column="2" Grid.RowSpan="2">
            </Button>
            <TextBox x:Name="TextBoxChannelNumber" Margin="102,12,364,8" Grid.Column="2" Grid.RowSpan="2"/>
            <Button Click="Serch" Content="Перейти" Margin="157,12,297,8" Background="White" Grid.Column="2" Grid.RowSpan="2"/>

            <Button Content="Предыдущая передача" Click="doPeredacha" Margin="10,5,10,5"/>
            <Button Content="Следующая передача" Click="afterPeredacha" Margin="10,5,10,5" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
